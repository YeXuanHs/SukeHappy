# sukehappy 本地授权 mock 服务（systemd unit）
#
# 用 Python 实现（ThreadingHTTPServer）：php -S 默认单线程，
# 配合 curl 的 keep-alive 会把唯一 worker 占住，后续请求全排队超时
# （表现为 FPM worker exit(1) → nginx 502）。
#
# 安装：
#   mkdir -p /root/sukehappy_mock
#   cp server.py /root/sukehappy_mock/
#   cp sukehappy-mock.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now sukehappy-mock
[Unit]
Description=SukeHappy local auth mock
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /root/sukehappy_mock/server.py
Restart=always
RestartSec=2
StandardOutput=append:/tmp/sukehappy_mock.log
StandardError=append:/tmp/sukehappy_mock.log

[Install]
WantedBy=multi-user.target
